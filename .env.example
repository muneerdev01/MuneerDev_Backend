# FastAPI service
APP_NAME=MuneerDev API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
NEXT_PUBLIC_APP_URL=https://www.example.com
PRIMARY_DOMAIN=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com,https://example.com
CORS_ALLOW_CREDENTIALS=false

# PostgreSQL (use a dedicated application user; never use a superuser)
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Authentication (generate independent random values of at least 32 bytes)
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
ADMIN_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Supabase Storage; service-role key is server-side only
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
STORAGE_BUCKET=media

# Stripe test values while validating; keep secret keys server-side
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Resend transactional mail
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=orders@example.com
